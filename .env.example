# Organisation API key from the Telgea dashboard (organisation settings).
# Keys are scoped per permission; a read-only key is enough unless the
# write switches below are turned on.
TELGEA_API_KEY=
TELGEA_BASE_URL=https://api.telgea.com
TELGEA_TIMEOUT_MS=30000

# Telgea allows 1000 requests per key per 24 hours. The server refuses
# locally once it has made this many in a rolling 24 hours. Set it lower when
# other integrations share the key. TELGEA_BUDGET_STATE keeps the window
# across restarts (a writable file, e.g. /data/budget.json).
TELGEA_DAILY_REQUEST_BUDGET=1000
TELGEA_BUDGET_STATE=
# Reads are reused for this long (ms) to save budget; any write clears it.
TELGEA_CACHE_TTL_MS=60000

# Users, teams, cost thresholds, suspension, data restriction, and the
# two-step prepare/commit (plans, lines, SIM swaps, port-ins, terminations,
# user deletion). Off unless exactly "true".
TELGEA_ENABLE_WRITES=false
# telgea_get_sim_credentials (eSIM activation code, PIN/PUK). Every other
# tool redacts these. Off unless exactly "true".
TELGEA_ENABLE_SIM_SECRETS=false
# HMAC key for prepared operations. Set it when running more than one
# replica or when a prepare should survive a restart; otherwise a random
# per-process key is used.
TELGEA_OPERATION_SECRET=

# JSONL audit log (who, tool, hashed target). Unset disables it.
TELGEA_AUDIT_LOG=

# HTTP transport: bearer token required on every /mcp request (compared in
# constant time). Set this whenever the server is reachable beyond loopback.
MCP_HTTP_TOKEN=
# Trust X-MCP-User from an authenticating gateway (requires MCP_HTTP_TOKEN;
# the server refuses to start otherwise). Requests without it are refused.
TELGEA_TRUST_FORWARDED_USER=false
# stdio: the user prepared operations are bound to (default "local").
TELGEA_DEFAULT_USER=
