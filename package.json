{
  "name": "mcp-server-telgea",
  "version": "0.1.0",
  "description": "MCP server for the Telgea mobile operator API: users, teams, user plans, lines/eSIMs, port-ins, usage, analytics, data pools, rates and cost thresholds.",
  "type": "module",
  "main": "./dist/transports/stdio.js",
  "exports": {
    ".": "./dist/transports/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "bin": {
    "mcp-server-telgea": "./dist/transports/stdio.js"
  },
  "scripts": {
    "build": "tsup src/transports/stdio.ts src/transports/http.ts src/server.ts --format esm --dts --clean --sourcemap",
    "dev": "tsx src/transports/stdio.ts",
    "dev:http": "tsx src/transports/http.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepack": "npm run typecheck && npm test && npm run build",
    "smoke:live": "tsx test/live-smoke.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borgels/mcp-server-telgea.git"
  },
  "keywords": [
    "mcp",
    "telgea",
    "telecom",
    "esim",
    "mobile"
  ],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11"
  },
  "bugs": {
    "url": "https://github.com/borgels/mcp-server-telgea/issues"
  },
  "homepage": "https://github.com/borgels/mcp-server-telgea#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "ip-address": ">=10.1.1",
    "hono": ">=4.12.25",
    "fast-uri": ">=3.1.2",
    "qs": ">=6.15.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsup": "^9.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
